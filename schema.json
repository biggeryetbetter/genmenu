{
  "title": "Revised Menu Schema",
  "description": "A schema that more closely follows the format of a typical menu",
  "type": "object",

  "properties": {
    "title": {
      "description": "What's the title of the menu?",
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "sections": {
      "description": "A section of the menu, which contains items.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "price": { "type": "number" }
              },
              "required": ["name", "price"]
            }
          },
          "varying_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "desc": { "type": "string" },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "name": { "type": "string" },
                      "price": { "type": "number" }
                    },
                    "required": [
                      "type",
                      "name",
                      "price"
                    ]
                  }
                },
                "addons": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "name": { "type": "string" },
                      "price": { "type": "number" }
                    },
                    "required": ["type", "name", "price"]
                  }
                }
              },
              "required": ["name", "variants", "addons"]
            }
          },
          "addons": {
            "type": "array",
            "items": {
            "type": "object",
            "properties": {
                "type": {
                "type": "string"
                },
                "name": { "type": "string" },
                "price": { "type": "number" }
            },
            "required": ["type", "name", "price"]
            }
          }
        },
        "required": ["name"]
      }
    },
    "addons": {
      "type": "array",
      "items": {
      "type": "object",
      "properties": {
          "type": {
          "type": "string"
          },
          "name": { "type": "string" },
          "price": { "type": "number" }
      },
      "required": ["type", "name", "price"]
      }
    }
  },
  "required": ["title", "sections"]
}