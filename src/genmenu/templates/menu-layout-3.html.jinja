{% extends "base.html.jinja" %}
{% block style %}
  body { padding: 40px 20px; }
  .board { max-width: 700px; margin: 0 auto; border: 6px solid var(--secondary); border-radius: 8px; padding: 30px; background: var(--surface); }
  h1 { text-align: center; font-size: 2.4em; margin: 0; color: var(--primary); text-shadow: 1px 1px 2px #000; }
  .subtitle { text-align: center; margin-bottom: 25px; color: var(--muted); }
  .item { display: flex; justify-content: space-between; font-size: 1.1em; padding: 6px 0; }
  .item .dots { flex: 1; border-bottom: 2px dotted var(--border); margin: 0 8px 6px; }
  .item .price { font-weight: bold; color: var(--accent); }
  .sizes { margin: 0 0 15px 20px; font-size: 0.9em; color: var(--muted); }
  .sizes > div { display: flex; justify-content: space-between; }
{% endblock %}
{% block body %}
  <div class="board">
    <h1><span class="ann-title">{{ title }}</span></h1>
    <p class="subtitle"><span class="ann-subtitle">{{ subtitle }}</span></p>
    {% for item in items %}
    {% if item.price is defined %}
    <div class="ann-item"><div class="item"><span class="ann-item-title">{{ item.name }}</span><span class="dots"></span><span class="price ann-item-price">{{ price(item.price) }}</span></div></div>
    {% else %}
    <div class="ann-item">
      <div class="item"><span class="ann-item-title">{{ item.name }}</span><span class="dots"></span><span></span></div>
      <div class="sizes">
        {% for variant in item.variants|select %}
        <div class="ann-variant"><span class="ann-variant-title">{{ variant.name }}</span><span class="ann-variant-price">{{ price(variant.price) }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
{% endblock %}
