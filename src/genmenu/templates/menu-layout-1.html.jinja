<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Corner Café — Menu</title>
<style>
  body { font-family: Arial, Helvetica, sans-serif; background:#fdf6ec; color:#333; margin:0; padding:40px 20px; }
  h1 { text-align:center; font-size:2.2em; margin-bottom:5px; }
  .subtitle { text-align:center; margin-bottom:30px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; max-width:900px; margin:0 auto; }
  .card { background:#fff; border-radius:10px; padding:18px; box-shadow:0 2px 6px rgba(0,0,0,0.1); }
  .card h2 { font-size:1.1em; margin:0 0 8px; width:fit-content; }
  .card p.desc { font-size:0.9em; margin:0 0 10px; width:fit-content; }
  .price { font-weight:bold; font-size:1.05em; }
  .variants { font-size:0.85em; margin-top:8px; width:fit-content; }
  .variants > span { display:block; }
{% if segmented %}
  h1 > span { background-color:#a9441c; color: transparent; }
  .subtitle > span { background-color:#888; color: transparent; }
  .card h2 { background-color:#a9441c; color: transparent; }
  .card p.desc { background-color:#666; color: transparent; }
  .price { background-color:#2e7d32; color: transparent; }
  .variants { background-color:#555; color: transparent; }
  .variants .variant-name { background-color: hsl(30, 80%, 50%); box-shadow: inset 0 0 0 1px #555; }
  .variants .variant-price { background-color:#2e7d32; box-shadow: inset 0 0 0 1px #555; }
{% else %}
  h1 { color:#a9441c; }
  .subtitle { color:#888; }
  .card h2 { color:#a9441c; }
  .card p.desc { color:#666; }
  .price { color:#2e7d32; }
  .variants { color:#555; }
{% endif %}
</style>
</head>
<body>
  <h1><span>{{ title }}</span></h1>
  <p class="subtitle"><span>{{ subtitle }}</span></p>
  <div class="grid">
    {% for item in items %}
      {% if item.variants %}
        <div class="card">
          <h2>{{item.name}}</h2>
          <p class="desc">{{item.desc}}</p>
          <div class="variants">
            {% for variant in item.variants %}
              <span><span class="variant-name">{{ variant.name }}</span> — <span class="variant-price">${{ variant.price }}</span></span>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="card">
          <h2>{{item.name}}</h2>
          <p class="desc">{{item.desc}}</p>
          <span class="price">${{item.price}}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</body>
</html>
