{% extends "base.html.jinja" %}
{% from "_macros.html.jinja" import badges %}
{% block style %}
  body { padding: 40px 20px; }
  h1 { text-align: center; font-size: 2.2em; margin-bottom: 5px; color: var(--primary); }
  .subtitle { text-align: center; margin-bottom: 30px; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; max-width: 900px; margin: 0 auto; }
  .card { background: var(--surface); border-radius: 10px; padding: 18px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); border: 1px solid var(--border); }
  .card .head { margin: 0 0 8px; }
  .card h2 { display: inline; font-size: 1.1em; margin: 0; color: var(--primary); }
  .card p.desc { font-size: 0.9em; margin: 0 0 10px; width: fit-content; color: var(--muted); }
  .price { font-weight: bold; font-size: 1.05em; color: var(--accent); }
  .variants { font-size: 0.85em; margin-top: 8px; width: fit-content; color: var(--text); }
  .variants > span { display: block; }
  .variant-price { color: var(--accent); }
{% endblock %}
{% block body %}
  <h1><span class="ann-title">{{ title }}</span></h1>
  <p class="subtitle"><span class="ann-subtitle">{{ subtitle }}</span></p>
  <div class="grid">
    {% for item in items %}
    <div class="card ann-item">
      <div class="head"><h2 class="ann-item-title">{{ item.name }}</h2>{{ badges(item) }}</div>
      {% if item.desc %}<p class="desc ann-item-desc">{{ item.desc }}</p>{% endif %}
      {% if item.variants is defined %}
      <div class="variants">
        {% for variant in item.variants|select %}
        <span class="ann-variant"><span class="ann-variant-title">{{ variant.name }}</span> — <span class="variant-price ann-variant-price">{{ price(variant.price) }}</span></span>
        {% endfor %}
      </div>
      {% else %}
      <span class="price ann-item-price">{{ price(item.price) }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
{% endblock %}
