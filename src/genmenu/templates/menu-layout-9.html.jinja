{% extends "base.html.jinja" %}
{% from "_macros.html.jinja" import badges, info_footer %}
{# Fine dining: centred, small caps, italic descriptions, flourish dividers #}
{% block style %}
  body { padding: 70px 24px; }
  .page { max-width: 560px; margin: 0 auto; text-align: center; }
  h1 { margin: 0; font-size: 2.8em; font-weight: 400; color: var(--primary); }
  .subtitle { margin: 8px 0 0; font-style: italic; color: var(--muted); }
  .divider { display: block; width: 240px; max-width: 100%; height: 32px; margin: 18px auto; }
  h2 { font-weight: 400; font-size: 1.3em; letter-spacing: 0.35em; text-transform: uppercase; color: var(--secondary); margin: 30px 0 18px; }
  .item { margin: 0 auto 22px; width: fit-content; max-width: 100%; }
  .name { font-variant: small-caps; letter-spacing: 0.08em; font-size: 1.1em; }
  .price { margin-left: 10px; color: var(--accent); }
  .desc { display: block; font-style: italic; color: var(--muted); font-size: 0.9em; margin: 4px auto 0; width: fit-content; max-width: 460px; }
  .variants { margin-top: 6px; font-size: 0.9em; }
  .variant { display: inline-block; white-space: nowrap; margin: 0 8px; }
  .variant .vp { color: var(--accent); margin-left: 5px; }
{% endblock %}
{% block body %}
<div class="page">
  <h1><span class="ann-title">{{ title }}</span></h1>
  <p class="subtitle"><span class="ann-subtitle">{{ subtitle }}</span></p>
  {% for section in sections %}
  {{ art.divider() }}
  <h2><span class="ann-section-title">{{ section.name }}</span></h2>
  {% for item in section.dishes %}
  <div class="item ann-item">
    <div><span class="name ann-item-title">{{ item.name }}</span>{% if item.price is defined %}<span class="price ann-item-price">{{ price(item.price) }}</span>{% endif %}{{ badges(item) }}</div>
    {% if item.desc %}<span class="desc ann-item-desc">{{ item.desc }}</span>{% endif %}
    {% if item.variants is defined %}
    <div class="variants">{% for v in item.variants|select %}<span class="variant ann-variant"><span class="ann-variant-title">{{ v.name }}</span><span class="vp ann-variant-price">{{ price(v.price) }}</span></span>{% endfor %}</div>
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
  {{ art.divider() }}
  {% if show_footer %}{{ info_footer(footer) }}{% endif %}
</div>
{% endblock %}
