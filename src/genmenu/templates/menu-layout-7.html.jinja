{% extends "base.html.jinja" %}
{% from "_macros.html.jinja" import badges, info_footer %}
{# Minimal, price-first: price column on the left, lots of whitespace #}
{% block style %}
  body { padding: 60px 24px; }
  .page { max-width: 640px; margin: 0 auto; }
  h1 { margin: 0; font-size: 3em; font-weight: 400; text-transform: lowercase; color: var(--text); }
  .subtitle { margin: 4px 0 40px; color: var(--muted); }
  h2 { font-family: var(--font-body); font-size: 0.85em; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent); margin: 36px 0 14px; padding-left: calc(5.5em + 18px); }
  .item, .v { display: grid; grid-template-columns: 5.5em 1fr; column-gap: 18px; align-items: baseline; }
  .item { margin-bottom: 16px; }
  .v { grid-column: 1 / -1; justify-self: start; font-size: 0.9em; margin-top: 3px; }
  .pc { text-align: right; color: var(--primary); font-weight: 700; font-variant-numeric: tabular-nums; }
  .name { font-weight: 600; }
  .desc { display: block; width: fit-content; color: var(--muted); font-size: 0.88em; margin-top: 2px; }
{% endblock %}
{% block body %}
<div class="page">
  <h1><span class="ann-title">{{ title }}</span></h1>
  <p class="subtitle"><span class="ann-subtitle">{{ subtitle }}</span></p>
  {% for section in sections %}
  <h2><span class="ann-section-title">{{ section.name }}</span></h2>
  {% for item in section.dishes %}
  <div class="item ann-item">
    <div class="pc">{% if item.price is defined %}<span class="ann-item-price">{{ price(item.price) }}</span>{% endif %}</div>
    <div><span class="name ann-item-title">{{ item.name }}</span>{{ badges(item) }}{% if item.desc %}<span class="desc ann-item-desc">{{ item.desc }}</span>{% endif %}</div>
    {% if item.variants is defined %}
    {% for v in item.variants|select %}
    <div class="v ann-variant"><div class="pc"><span class="ann-variant-price">{{ price(v.price) }}</span></div><div><span class="ann-variant-title">{{ v.name }}</span></div></div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
  {% if show_footer %}{{ info_footer(footer) }}{% endif %}
</div>
{% endblock %}
