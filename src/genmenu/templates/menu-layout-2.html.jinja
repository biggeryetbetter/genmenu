{% extends "base.html.jinja" %}
{% from "_macros.html.jinja" import info_footer %}
{% block style %}
  body { padding: 50px 20px; }
  .menu { max-width: 600px; margin: 0 auto; }
  h1 { text-align: center; letter-spacing: 3px; font-size: 2em; margin-bottom: 0; color: var(--primary); }
  .subtitle { text-align: center; letter-spacing: 2px; font-size: 0.8em; margin-bottom: 40px; color: var(--muted); }
  .row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; border-bottom: 1px dotted var(--border); padding-bottom: 8px; }
  .row .name { font-size: 1.1em; }
  .row .name small { display: block; width: fit-content; font-size: 0.75em; font-style: italic; margin-top: 3px; color: var(--muted); }
  .row .price { font-size: 1.05em; white-space: nowrap; margin-left: 15px; color: var(--accent); }
  .variant-block .name { width: 100%; }
  .variant-block ul { list-style: none; padding: 0; margin: 6px 0 0 auto; width: fit-content; text-align: right; }
  .variant-block li { font-size: 0.95em; color: var(--accent); }
{% endblock %}
{% block body %}
  <div class="menu">
    <h1><span class="ann-title">{{ title }}</span></h1>
    <p class="subtitle"><span class="ann-subtitle">{{ subtitle }}</span></p>
    {% for item in items %}
    {% if item.price is defined %}
    <div class="row ann-item">
      <div class="name"><span class="ann-item-title">{{ item.name }}</span>{% if item.desc %}<small class="ann-item-desc">{{ item.desc }}</small>{% endif %}</div>
      <div class="price ann-item-price">{{ price(item.price) }}</div>
    </div>
    {% else %}
    <div class="row variant-block ann-item">
      <div class="name"><span class="ann-item-title">{{ item.name }}</span>{% if item.desc %}<small class="ann-item-desc">{{ item.desc }}</small>{% endif %}
        <ul>
          {% for variant in item.variants|select %}
          <li class="ann-variant"><span class="ann-variant-title">{{ variant.name }}</span> — <span class="ann-variant-price">{{ price(variant.price) }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% if show_footer %}{{ info_footer(footer) }}{% endif %}
  </div>
{% endblock %}
