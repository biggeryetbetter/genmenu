<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title }} — Menu</title>
<style>
  body { font-family: Georgia, 'Times New Roman', serif; background:#1f2422; color:#eae6da; margin:0; padding:50px 20px; }
  .menu { max-width:600px; margin:0 auto; }
  h1 { text-align:center; letter-spacing:3px; font-size:2em; margin-bottom:0; }
  .subtitle { text-align:center; letter-spacing:2px; font-size:0.8em; margin-bottom:40px; }
  .row { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px; border-bottom:1px dotted #555; padding-bottom:8px; }
  .row .name { font-size:1.1em; }
  .row .name small { display:block; width:fit-content; font-size:0.75em; font-style:italic; margin-top:3px; }
  .row .price { font-size:1.05em; white-space:nowrap; margin-left:15px; }
  .variant-block .name small.variants { font-style:normal; }
  .variant-block ul { list-style:none; padding:0; margin:6px 0 0 auto; width:fit-content; text-align:right; }
  .variant-block li { font-size:0.95em; }
{% if segmented %}
  h1 > span { background-color:#a9441c; color: transparent; }
  .subtitle > span { background-color:#888; color: transparent; }
  .row .item-name { background-color:#a9441c; color: transparent; }
  .row .name small { background-color:#666; color: transparent; }
  .row .price { background-color:#2e7d32; color: transparent; }
  .variant-block ul { background-color:#555; color: transparent; }
  .variant-block .variant-name { background-color: hsl(30, 80%, 50%); box-shadow: inset 0 0 0 1px #555; }
  .variant-block .variant-price { background-color:#2e7d32; box-shadow: inset 0 0 0 1px #555; }
{% else %}
  h1 { color:#d4af6a; }
  .subtitle { color:#9c9484; }
  .row .name small { color:#9c9484; }
  .row .price { color:#d4af6a; }
  .variant-block li { color:#d4af6a; }
{% endif %}
</style>
</head>
<body>
  <div class="menu">
    <h1><span>{{ title }}</span></h1>
    <p class="subtitle"><span>{{ subtitle }}</span></p>

    {% for item in items %}
    {% if item.price is defined %}
    <div class="row">
      <div class="name"><span class="item-name">{{ item.name }}</span><small>{{ item.desc }}</small></div>
      <div class="price">${{ '%.2f'|format(item.price) }}</div>
    </div>
    {% elif item.variants is defined %}
    <div class="row variant-block">
      <div class="name"><span class="item-name">{{ item.name }}</span><small>{{ item.desc }}</small>
        <ul>
          {% for variant in item.variants %}
          <li><span class="variant-name">{{ variant.name }}</span> — <span class="variant-price">${{ '%.2f'|format(variant.price) }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
</body>
</html>
